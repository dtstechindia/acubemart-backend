NODE_ENV=production
PORT=8000

MONGODB_URI=
DB_NAME=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must exactly match the secret configured on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# Dedicated Google Play reviewer account. Keep disabled outside review windows.
# PLAY_REVIEW_PHONE may be either 10 digits or include the +91 country code.
PLAY_REVIEW_ENABLED=false
PLAY_REVIEW_COUNTRY_CODE=91
PLAY_REVIEW_PHONE=
PLAY_REVIEW_OTP=
PLAY_REVIEW_NAME=Google Play Reviewer
PLAY_REVIEW_EMAIL=google-play-review@acubemart.in

# Never enable this in production.
EXPOSE_ERROR_STACK=false
